NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-side only. Do not expose this in browser/client code.
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Migration scripts
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dev-only auth bypass. When DEV_BYPASS_AUTH=true (and NODE_ENV is not
# production), the middleware skips the login page, redirects / and /login to
# /home, and injects DEV_BYPASS_USER_ID as the session user. Must be an id that
# exists in the users table. Leave unset for normal auth.
DEV_BYPASS_AUTH=false
DEV_BYPASS_USER_ID=
