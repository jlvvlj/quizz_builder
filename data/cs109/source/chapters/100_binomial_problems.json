     ],
     "text": "Question 3:",
     "type": "text"
    },
    {
     "text": " A machine learning algorithm makes binary predictions. The machine learning algorithm makes 50 guesses where the probability of an incorrect prediction on a given guess is 19/25. What is the probability that the number of correct predictions is greater than 0?",
     "type": "text"
    }
   ],
   "type": "paragraph"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Answer 3:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " be the number of correct predictions.\n",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X \\sim \\Bin(n = 50, p = 6/25)"
       },
       "type": "math_inline"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\P(X > 0) &=  1 - \\P(0 \\le X \\le 0)\\\\\n &= 1 - {n \\choose 0} p^0 (1 - p)^{n - 0}\n\\end{aligned}"
     },
     "type": "block-tex"
    }
