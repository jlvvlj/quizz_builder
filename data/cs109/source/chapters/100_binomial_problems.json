    {
     "text": "Just for fun (and to give you a lot of practice) I wrote a generative probabilistic program which could sample binomial distribution problems. Here are 100 binomial questions:",
     "type": "text"
    }
   ],
   "type": "paragraph"
  },
  {
   "attrs": {
    "id": null,
    "level": "3",
    "textAlign": "left"
   },
   "content": [
    {
     "text": "Questions",
     "type": "text"
    }
   ],
