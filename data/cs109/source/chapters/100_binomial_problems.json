   },
   "content": [
    {
     "marks": [
      {
       "type": "bold"
      },
      {
       "type": "italic"
      }
     ],
     "text": "Question 1:",
     "type": "text"
    },
    {
     "text": " Laura is running a server cluster with 50 computers. The probability of a crash on a given server is 0.5. What is the standard deviation of crashes?",
     "type": "text"
    }
   ],
   "type": "paragraph"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Answer 1:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " be the number of crashes.\n",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X \\sim \\Bin(n = 50, p = 0.5)"
       },
       "type": "math_inline"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{Std}(X) &= \\sqrt{np(1-p)} \\\\ &= \\sqrt{50 \\cdot 0.5 \\cdot (1 - 0.5)}\\\\ &= 3.54\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
