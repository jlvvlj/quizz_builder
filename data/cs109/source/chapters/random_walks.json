    },
    {
     "attrs": {
      "showEditor": false,
      "value": "N_3"
     },
     "type": "math_inline"
    },
    {
     "text": ", so 9 outcomes overall.",
     "type": "text"
    }
   ],
   "type": "paragraph"
  },
  {
   "attrs": {
    "textAlign": "left"
   },
   "content": [
    {
     "text": "In the case of not-",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "A_2"
     },
     "type": "math_inline"
    },
    {
     "text": ": we have 3 options for ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "N_1"
     },
     "type": "math_inline"
    },
    {
     "text": ", 2 options for ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "N_2"
     },
     "type": "math_inline"
    },
    {
     "text": " and ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "N_3"
     },
     "type": "math_inline"
    },
    {
     "text": " since they can each be any letter besides ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "A"
     },
     "type": "math_inline"
    },
    {
     "text": " or the letter we chose previously.",
     "type": "text"
    }
   ],
   "type": "paragraph"
  },
  {
   "attrs": {
    "textAlign": "left"
   },
   "content": [
    {
     "text": "Putting these counts together, ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "|E| = 9 + 3 \\cdot 2 \\cdot 2 = 21"
     },
     "type": "math_inline"
    },
    {
     "text": ". Using ",
     "type": "text"
    },
    {
     "attrs": {
      "showEditor": false,
      "value": "|S| = 3^4"
     },
     "type": "math_inline"
    },
    {
