       },
       "type": "link"
      }
     ],
     "text": "1",
     "type": "text"
    },
    {
     "marks": [
      {
       "attrs": {
        "color": "rgb(33, 37, 41)"
       },
       "type": "textStyle"
      }
     ],
     "text": "] The original source on the oral arguments of the case",
     "type": "text"
    }
   ],
