{
 "content": [
  {
   "attrs": {
    "id": null,
    "level": "3",
    "textAlign": "left"
   },
   "content": [
    {
     "text": "Probability Rules",
     "type": "text"
    }
   ],
   "type": "heading"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition:",
       "type": "text"
      },
      {
       "text": " Empirical Definition of Probability",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "The probability of any event ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " can be defined as:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E) = \\lim_{n \\rightarrow \\infty} \\frac{\\text{count}(E)}{n}\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Where ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\text{count}(E)"
       },
       "type": "math_inline"
      },
      {
       "text": " is the number of times that ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " occurred in n experiments.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition:",
       "type": "text"
      },
      {
       "text": " Core Identities",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For an event ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " and a sample space ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "S"
       },
       "type": "math_inline"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "sourceBytes": 817,
      "sourceSha256": "569bf34ba8c5ec0cc705ac164860aadc5848eb30ea81792fc3a4c3f83513cb51"
     },
     "type": "interactive-demo"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition:",
       "type": "text"
      },
      {
       "text": " Probability of Equally Likely Outcomes",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "If ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "S"
       },
       "type": "math_inline"
      },
      {
       "text": " is a sample space with equally likely outcomes, for an event ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " that is a subset of the outcomes in ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "S"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E) &= \\frac{\\text{number of outcomes in $E$}}{\\text{number of outcomes in $S$}} \n= \\frac{|E|}{|S|}\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Conditional Probability.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "The probability of ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " given that (aka conditioned on) event ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": " already happened:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E |F) = \\frac{\\p(E \\and F)}{\\p(F)}\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Probability of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "or",
       "type": "text"
      },
      {
       "text": " with Mutually Exclusive Events",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "If two events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": " are mutually exclusive then the probability of ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "or",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": " occurring is:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E \\or F) = \\p(E) + \\p(F)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For n events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E_1, E_2, \\dots E_n"
       },
       "type": "math_inline"
      },
      {
       "text": " where each event is mutually exclusive of one another (in other words, no outcome is in more than one event). Then:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E_1 \\or E_2 \\or \\dots \\or E_n) = \\p(E_1) + \\p(E_2) + \\dots + \\p(E_n) = \\sum_{i=1}^n \\p(E_i)\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": General Probability of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "or",
       "type": "text"
      },
      {
       "text": " (Inclusion-Exclusion)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For any two events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E \\or F) = \\p(E) + \\p(F) − \\p(E \\and F)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For three events, ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": ", ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": ", and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "G"
       },
       "type": "math_inline"
      },
      {
       "text": " the formula is:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E \\or F \\or G) =&\\, \\p(E) + \\p(F) + \\p(G) \\\\\n& −\\p(E \\and F) − \\p(E \\and G)−P(F \\and G) \\\\\n& +\\p(E \\and F \\and G)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For more than three events see the chapter of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "class": null,
          "href": "./prob_or#inclusion-exclusion-with-many-events",
          "rel": "noopener noreferrer nofollow",
          "target": "_blank"
         },
         "type": "link"
        }
       ],
       "text": "probability of or",
       "type": "text"
      },
      {
       "text": ".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Probability of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "and",
       "type": "text"
      },
      {
       "text": " for Independent Events.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "If two events: ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": ", ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": " are independent then the probability of ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "and",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": " occurring is:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E \\and F) = \\p(E) \\cdot \\p(F)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For n events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E_1, E_2, \\dots E_n"
       },
       "type": "math_inline"
      },
      {
       "text": " that are independent of one another:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E_1 \\and E_2 \\and \\dots \\and E_n) = \\prod_{i=1}^n \\p(E_i)\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": General Probability of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "and",
       "type": "text"
      },
      {
       "text": " (The Chain Rule)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For any two events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E \\and F) = \\p(E | F) \\cdot \\p(F)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For n events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E_1, E_2, \\dots E_n"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E_1& \\and E_2 \\and \\dots \\and E_n) \\\\\n= &\\p(E_1) \\cdot \\p(E_2|E_1) \\cdot \\p(E_3 |E_1 \\and E_2) \\dots  \\\\  &\\p(E_n|E_1 \\dots E_{n−1})\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": The Law of Total Probability",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For any two events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "E"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "F"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E) &= \\p(E \\and F) + \\p(E \\and F^\\c)\\\\\n&=\\p(E | F) \\p(F) + \\p(E | F^\\c) \\p(F^\\c)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "For ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "class": null,
          "href": "https://{{pathToRoot}}/prob_or",
          "rel": "noopener noreferrer nofollow",
          "target": "_blank"
         },
         "type": "link"
        }
       ],
       "text": "mutually exclusive",
       "type": "text"
      },
      {
       "text": " events: ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "B_1, B_2, \\dots B_n"
       },
       "type": "math_inline"
      },
      {
       "text": " such that every outcome in the sample space falls into one of those events:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(E) \n&= \\sum_{i=1}^n \\p(E \\and B_i) && \\text{Extension of our observation}\\\\\n&= \\sum_{i=1}^n \\p(E | B_i) \\p(B_i) && \\text{Using chain rule on each term}\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Bayes' Theorem",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": " The most common form of Bayes' Theorem is ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        }
       ],
       "text": "Bayes' Theorem Classic",
       "type": "text"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(B|E) = \\frac{\\p(E | B) \\cdot \\p(B)}{\\p(E)}\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Bayes' Theorem combined with the Law of Total Probability:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(B|E) = \\frac{\\p(E | B) \\cdot \\p(B)}{\\p(E|B)\\cdot \\p(B) + \\p(E|B^\\c) \\cdot \\p(B^\\c)}\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Bayes' Theorem with the General Law of Total Probaiblity",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "If a set of events ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "B_j"
       },
       "type": "math_inline"
      },
      {
       "text": " are mutually exclusive and ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "class": null,
          "href": "https://en.wikipedia.org/wiki/Collectively_exhaustive_events",
          "rel": "noopener noreferrer nofollow",
          "target": "_blank"
         },
         "type": "link"
        }
       ],
       "text": "collectively exhaustive",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        }
       ],
       "text": " ",
       "type": "text"
      },
      {
       "text": "(eg at least one of the events must occur) then:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\p(B_i | E) &= \\frac{\\p(E|B_i) \\cdot \\p(B_i)}{\\p(E)}\n&& \\text{Bayes Theorem} \\\\\n &= \\frac{\\p(E|B_i) \\cdot \\p(B_i)}{\\sum_{j=1}^n \\p(E|B_j) \\cdot \\p(B_j)}\n&& \\href{./law_total}{\\text{LOTP}} \\\\\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "attrs": {
    "textAlign": "left"
   },
   "type": "paragraph"
  },
  {
   "attrs": {
    "id": "expectation-and-variance",
    "level": "3",
    "textAlign": "left"
   },
   "content": [
    {
     "text": "Expectation and Variance",
     "type": "text"
    }
   ],
   "type": "heading"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Expectation",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "The expectation of a random variable ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": ", written ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\text{E}[X]"
       },
       "type": "math_inline"
      },
      {
       "text": " is the average of all the values the random variable can take on, each weighted by the probability that the random variable will take on that value:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{E}[X] = \\sum_x x \\cdot \\p(X=x)\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Property",
       "type": "text"
      },
      {
       "text": ": Linearity of Expectation",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{E}[aX + b] = a\\text{E}[X]+b\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Where ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "a"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "b"
       },
       "type": "math_inline"
      },
      {
       "text": " are constants and not random variables.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Property",
       "type": "text"
      },
      {
       "text": ": Expectation of the Sum of Random Variables",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{E}[X+Y] = \\text{E}[X] + \\text{E}[Y]\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "This is true regardless of the relationship between ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "Y"
       },
       "type": "math_inline"
      },
      {
       "text": ". They can be dependent, and they can have different distributions. This also applies with more than two random variables.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{E}\\Big[\\sum_{i=1}^n X_i\\Big] = \\sum_{i=1}^n \\text{E}[X_i]\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Property",
       "type": "text"
      },
      {
       "text": ": Law of The Unconscious Statistician (LOTUS)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{E}[g(X)] = \\sum_x g(x)\\p(X=x)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "One can also calculate the expected value of a function ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "g(X)"
       },
       "type": "math_inline"
      },
      {
       "text": " of a random variable ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " when one knows the probability distribution of ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " but one does not explicitly know the distribution of ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "g(X)"
       },
       "type": "math_inline"
      },
      {
       "text": ". This theorem has the humorous name of \"the Law of the Unconscious Statistician\" (LOTUS), because it is so useful that you should be able to employ it unconsciously.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Variance of a Random Variable",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "justify"
     },
     "content": [
      {
       "text": "The variance is a measure of the \"spread\" of a random variable around the mean. Variance for a random variable, ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": ", with expected value ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\text{E}[X] = µ"
       },
       "type": "math_inline"
      },
      {
       "text": " is:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\text{Var}(X) = \\text{E}[(X–µ)^2]"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "justify"
     },
     "content": [
      {
       "text": "Semantically, this is the average distance of a sample from the distribution to the mean. When computing the variance often we use a different (equivalent) form of the variance equation:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{Var}(X) &= \\text{E}[X^2] - \\text{E}[X]^2\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "attrs": {
    "id": "probability-theory",
    "level": "3",
    "textAlign": "left"
   },
   "content": [
    {
     "text": "Probability Theory",
     "type": "text"
    }
   ],
   "type": "heading"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ":",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "italic"
        }
       ],
       "text": " ",
       "type": "text"
      },
      {
       "text": "The Central Limit Theorem (Sum Version)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X_1, X_2 \\dots X_n"
       },
       "type": "math_inline"
      },
      {
       "text": " be independent and identically distributed random variables. The ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        }
       ],
       "text": "sum",
       "type": "text"
      },
      {
       "text": " of these random variables approaches a normal as ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "n \\rightarrow \\infty"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\sum_{i=1}^{n}X_i \\sim N\\bigl(n \\cdot \\mu,\\; n \\cdot \\sigma^2\\bigr)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Where ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\mu = \\E[X_i]"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\sigma^2 = \\Var(X_i)"
       },
       "type": "math_inline"
      },
      {
       "text": ". Note that since each ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X_i"
       },
       "type": "math_inline"
      },
      {
       "text": " is identically distributed they share the same expectation and variance.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ":",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "italic"
        }
       ],
       "text": " ",
       "type": "text"
      },
      {
       "text": "The Central Limit Theorem (Average Version)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X_1, X_2 \\dots X_n"
       },
       "type": "math_inline"
      },
      {
       "text": " be independent and identically distributed random variables. The ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "bold"
        }
       ],
       "text": "average",
       "type": "text"
      },
      {
       "text": " of these random variables approaches a normal as ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "n \\rightarrow \\infty"
       },
       "type": "math_inline"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\frac{1}{n}\\sum_{i=1}^{n}X_i \\sim N\\bigl(\\mu,\\; \\frac{\\sigma^2}{n}\\bigr)\n\\end{aligned}"
     },
     "type": "block-tex"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Where ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\mu = \\E[X_i]"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "\\sigma^2 = \\Var(X_i)"
       },
       "type": "math_inline"
      },
      {
       "text": ".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition",
       "type": "text"
      },
      {
       "text": ": Entropy",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "H"
       },
       "type": "math_inline"
      },
      {
       "text": " be our measure of how much uncertainty we have about a random variable ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": ". Define ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "H"
       },
       "type": "math_inline"
      },
      {
       "text": " to be the expected surprise of observing the assignment to ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": ". ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "H(X) = E[\\text{Surprise}(X)]"
       },
       "type": "math_inline"
      },
      {
       "text": ". Using the Law of Unconscious Statistician, and the definition of Surprise of an event, we can expand out the formula for ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "H"
       },
       "type": "math_inline"
      },
      {
       "text": " as:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\nH(X) \n&= \\sum_{x \\in X} \\text{Surprise}(X=x) \\cdot \\p(X=x)\\\\\n&= - \\sum_{x \\in X} \\log_2 P(X=x)\\cdot P(X=x)\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  },
  {
   "content": [
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ],
       "text": "Definition:",
       "type": "text"
      },
      {
       "text": " Kullback–Leibler Divergence",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "textAlign": "left"
     },
     "content": [
      {
       "text": "Let ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "X"
       },
       "type": "math_inline"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "showEditor": false,
        "value": "Y"
       },
       "type": "math_inline"
      },
      {
       "text": " be discrete random variables:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "rawTex": "\\begin{aligned}\n\\text{KL}(X, Y)\n&= \\sum_{x \\in X} \\text{ExcessSurprise}(x) \\cdot P(X=x) \\\\\n&= \\sum_{x \\in X}\\ \\log_2 \\frac{P(X=x)}{P(Y=x)} \\cdot P(X=x) \\\\\n\\end{aligned}"
     },
     "type": "block-tex"
    }
   ],
   "type": "borderedBox"
  }
 ],
 "type": "doc"
}
